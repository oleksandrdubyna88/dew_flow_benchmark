<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-cutting host wiring: logging, and nothing else yet. Referenced by hosts, never by the
       domain — a library that configures a sink is a library that decides for its consumer. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
