<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters: the store, git checkouts, engine clients, model runtimes, the hardware sampler.
       Implements the Application's ports; nothing here is referenced back by Application. -->

  <ItemGroup>
    <!-- Logging abstractions, the pooled-socket HttpClientFactory for the model runtime and the glob matcher for the
         baseline engine's find_files come WITH the ASP.NET Core framework reference below, so they are no longer
         package references here (NU1510 refuses a reference the framework already carries). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Design-time only: the migrations tool needs it, the shipped adapter must not carry it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gate's recording tap is a loopback HTTP server per cell (Kestrel). A framework reference, not a package:
         it ships with the runtime, and a hand-rolled listener would be a second HTTP stack to get right. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bench.Application\Bench.Application.csproj" />
  </ItemGroup>

</Project>
