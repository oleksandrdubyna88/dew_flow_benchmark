<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters: the store, git checkouts, engine clients, model runtimes, the hardware sampler.
       Implements the Application's ports; nothing here is referenced back by Application. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Pooled sockets for the model runtime: a benchmark opens one connection per leg and a
         run has tens of thousands of them. Microsoft-published, so it clears the package policy. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Design-time only: the migrations tool needs it, the shipped adapter must not carry it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Glob matching for the baseline engine's find_files. Microsoft-owned, MIT, and already in this
         graph transitively — writing a second glob matcher by hand is how the baseline's behaviour
         starts differing from every other tool the subject has ever used. -->
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bench.Application\Bench.Application.csproj" />
  </ItemGroup>

</Project>
