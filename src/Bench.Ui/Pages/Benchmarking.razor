@page "/benchmarking"

<PageTitle>Benchmarking</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Benchmarking</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Loading" @onclick="ReloadAsync">
        @(Loading ? "Reading…" : "Refresh")
    </button>
</div>

@if (!Runs.Available && Runs.Detail.Length > 0)
{
    @* The API could not be read. Deliberately not the same panel as "no runs": one sends the reader to the
       daemon, the other to the CLI. *@
    <div class="alert alert-warning">@Runs.Detail</div>
}

@* The refusal, above the numbers rather than below them. A reader who takes two averages as a comparison
   has been misled by the layout, whatever the text says further down. *@
<div class="alert @(Arms.Groups.Count > 1 ? "alert-info" : "alert-secondary")">
    <strong>Not a ranking.</strong> @Arms.Refusal
    @if (Arms.Differences.Count > 0)
    {
        <ul class="mb-0 mt-2">
            @foreach (var difference in Arms.Differences)
            {
                <li>@difference</li>
            }
        </ul>
    }
</div>

@foreach (var group in Arms.Groups)
{
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            @if (group.Declared)
            {
                <code>@group.Arm</code>
            }
            else
            {
                @* An absence, placed apart from the arms. Folding these in among them would let un-echoed
                   runs read as an arm's own result. *@
                <span class="badge text-bg-secondary">@group.Arm</span>
                <small class="text-body-secondary">the engine echoed no backend — these rows say nothing about a sidecar</small>
            }
            <span class="ms-auto text-body-secondary">@group.Runs.Count run(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th scope="col">Run</th>
                        <th scope="col">Suite</th>
                        <th scope="col">Target</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in group.Runs)
                    {
                        <tr>
                            <td><NavLink href="@($"/benchmarking/runs/{run.RunId}")">@run.Label</NavLink></td>
                            <td><code>@run.SuiteStamp</code></td>
                            <td class="text-break"><small>@run.TargetCanonical</small></td>
                            <td>@run.Status</td>
                            <td><time datetime="@run.CreatedAt.ToString("o")">@run.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
