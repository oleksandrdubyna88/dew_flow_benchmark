@page "/benchmarking/sidecar/arms"

<PageTitle>Benchmarking · Sidecar · Arms</PageTitle>

<h1 class="h3 mb-3">Benchmarking</h1>
<BenchmarkTabs />
<SidecarViews />

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label" for="metric">Metric</label>
        <select class="form-select" id="metric" value="@Metric" @onchange="ChooseMetricAsync" disabled="@Loading">
            @* No option pre-selected: a default would make every number below it about a choice nobody made. *@
            <option value="">— choose a metric —</option>
            @foreach (var name in Metrics.Value ?? [])
            {
                <option value="@name">@name</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label" for="baseline">Baseline</label>
        <select class="form-select" id="baseline" value="@Baseline" @onchange="ChooseBaselineAsync"
                disabled="@(Loading || Arms.Count == 0)">
            @* A control, because nominating one is a DECISION. An arm that became the baseline because it
               scored highest could not then be beaten, and every verdict would be circular. *@
            <option value="">— none, so no arm is a winner —</option>
            @foreach (var arm in Arms)
            {
                <option value="@arm">@arm</option>
            }
        </select>
    </div>
</div>

@if (!Metrics.Available && Metrics.Detail.Length > 0)
{
    <div class="alert alert-warning">@Metrics.Detail</div>
}
else if (Metrics.Available && Metrics.Value!.Count == 0)
{
    @* Not the same as "choose one": there is nothing to choose. An empty control with a prompt beside it
       would leave the reader clicking at a list that will never open. *@
    <div class="alert alert-info">
        <strong>No arm has carried a metric yet.</strong> These runs declared a backend but recorded no
        scored metric, so there is nothing to compare them on.
    </div>
}
else if (Metric.Length == 0)
{
    <div class="alert alert-secondary">Name the metric to compare on — there is no default.</div>
}
else if (!Comparison.Available)
{
    <div class="alert alert-warning">@(Comparison.Detail.Length > 0 ? Comparison.Detail : "Reading…")</div>
}
else
{
    var comparison = Comparison.Value!;

    @if (comparison.Refusal.Length > 0)
    {
        @* Above everything, and never merged with the per-scope refusal: "no run echoed a backend" is a
           wiring problem, "every run echoed the same one" means go and measure the other backend. *@
        <div class="alert alert-info"><strong>Nothing to compare.</strong> @comparison.Refusal</div>
    }

    @if (comparison.Excluded.Count > 0)
    {
        <div class="alert alert-secondary">
            <strong>Left out.</strong>
            <ul class="mb-0 mt-2">
                @foreach (var excluded in comparison.Excluded)
                {
                    <li>@excluded</li>
                }
            </ul>
        </div>
    }

    @foreach (var scope in comparison.Scopes)
    {
        <div class="card mb-3">
            <div class="card-header">
                @* The scope is a header rather than a footnote: it is the pair that must be identical before
                   any two numbers below may be read against each other. *@
                <div><code>@scope.SuiteStamp</code></div>
                <small class="text-body-secondary text-break">@scope.TargetCanonical</small>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Arm</th>
                            @* Every column says which AGGREGATE it is. They are not the same kind of number --
                               a mean, a sum and a max sit side by side here -- and a table of bare figures
                               invites the reader to compare two of them as though they were. *@
                            <th scope="col">Average <small class="fw-normal text-body-secondary">mean / leg</small></th>
                            <th scope="col">Legs</th>
                            <th scope="col">Runs</th>
                            <th scope="col">Retrieval <small class="fw-normal text-body-secondary">mean / leg</small></th>
                            <th scope="col">Wall <small class="fw-normal text-body-secondary">total</small></th>
                            <th scope="col">Hits / files <small class="fw-normal text-body-secondary">mean / leg</small></th>
                            <th scope="col">Peak VRAM <small class="fw-normal text-body-secondary">max</small></th>
                            <th scope="col">Selection half</th>
                            <th scope="col">Held-out half</th>
                            <th scope="col">Verdict</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var arm in scope.Arms)
                        {
                            <tr>
                                <td><code>@arm.Arm</code>@if (arm.Arm == scope.Baseline)
                                    {
                                        <span class="badge text-bg-light ms-1">baseline</span>
                                    }</td>
                                <td>@arm.Average.ToString("0.###")</td>
                                <td>@arm.Legs</td>
                                <td>@arm.Runs</td>
                                <td>@arm.Cost.RetrievalMs.ToString("0") ms</td>
                                <td><small>@arm.Cost.WallSeconds.ToString("0.#") s</small></td>
                                <td><small>@arm.Cost.Hits.ToString("0.#") / @arm.Cost.Files.ToString("0.#")</small></td>
                                <td><small>@Vram(arm.Cost)</small></td>
                                <td><small>@Half(arm.Selection)</small></td>
                                <td><small>@Half(arm.HeldOut)</small></td>
                                <td>
                                    @if (arm.Proof != "NotAWinner")
                                    {
                                        <span class="badge @Badge(arm.Proof)">@arm.Proof</span>
                                    }
                                    @if (arm.Proof == "Confirmed")
                                    {
                                        <small class="ms-1">@arm.Margin.ToString("+0.###;-0.###;0")</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (scope.RankingRefusal.Length > 0)
            {
                <div class="card-footer text-body-secondary"><small>@scope.RankingRefusal</small></div>
            }
        </div>
    }
}
