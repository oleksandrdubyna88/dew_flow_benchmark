<Project Sdk="Microsoft.NET.Sdk">

  <!-- Use cases and PORTS. Every interface an adapter implements is declared here and nowhere else:
       IBenchStore, IEngine, IModelRuntime, IRunTrace, IHardwareSampler, IJudge, ICheckoutProvider. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Adopted: the evaluator/metric model. The Domain stays package-free; this layer is where the
         boundary to it lives (MetricCodec), which the architecture test still allows. -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bench.Domain\Bench.Domain.csproj" />
    <ProjectReference Include="..\Bench.Contracts\Bench.Contracts.csproj" />
    <!-- The delivered-work module: a SIBLING LEAF this layer is the ONLY one allowed to reference,
         which is what keeps its recompute property tied to one orchestration. ArchitectureTests
         asserts both halves of that. -->
    <ProjectReference Include="..\Bench.Delivered\Bench.Delivered.csproj" />
  </ItemGroup>

</Project>
