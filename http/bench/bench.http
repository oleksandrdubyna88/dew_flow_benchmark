# The read API and the planner — everything under `/api/bench` except the session routes.
#
# This host maps NO write route: the claim path is not reachable by a GET, and a port it never
# registers cannot be reached by a route that does not exist. So every request here is safe to repeat,
# and the suite leaves nothing behind.

# @name bench_health_answers_ok
# @prod
GET {{baseUrl}}/api/bench/health
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('the probe names its verdict', () => {
    assert.strictEqual(response.parsedBody.status, 'ok');
  });
}}

###
# Planning is a PURE computation — it writes nothing, which is what makes it safe to assert here. It
# is also the one place the matrix's shape is decided, so its refusals are the interesting half.
# The suite document is read from samples/, relative to the repository root the runner works from.
# @name plan_expands_a_suite_into_a_matrix_of_cells
{{
  const fs = require('node:fs');
  // Built here rather than written inline because `suiteJson` is a JSON document INSIDE a JSON
  // field, and a hand-escaped copy of a file that lives in the repository is a second copy that
  // drifts. The path is relative to the repository root, which is where the runner works from.
  exports.planBody = JSON.stringify({
    repo: 'https://github.com/example/repo.git',
    commit: wellFormedSha,
    suiteJson: fs.readFileSync('samples/demo-suite.json', 'utf8'),
    repeats: 1,
    seed: 1,
    subjects: ['m1@local'],
    lanes: ['arch'],
  });
}}
POST {{baseUrl}}/api/bench/plan
Content-Type: application/json

{{planBody}}

?? status == 200

{{
  const assert = require('node:assert');
  const plan = response.parsedBody;
  test('the target is canonical — a plan is identified by what it ran against, not by a label', () => {
    assert.match(plan.targetCanonical, /^https:\/\/github\.com\/example\/repo\.git@[0-9a-f]{40}/);
  });
  test('the suite is stamped, so two runs of "the same" suite cannot be silently different', () => {
    assert.match(plan.suiteStamp, /^demo@/);
  });
  test('every question becomes cells, and each cell says which leg and position it holds', () => {
    assert.ok(plan.questionCount > 0);
    assert.ok(Array.isArray(plan.cells) && plan.cells.length > 0);
    for (const cell of plan.cells) {
      assert.ok(cell.questionId.length > 0);
      assert.ok(cell.leg.length > 0, 'a cell with no leg cannot be attributed to an arm');
      assert.strictEqual(typeof cell.position, 'number');
    }
  });
}}

###
# @name plan_without_a_repository_is_refused_with_a_reason
POST {{baseUrl}}/api/bench/plan
Content-Type: application/json

{}

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal says what is missing rather than "bad request"', () => {
    assert.match(response.parsedBody.reason, /repository url/i);
  });
}}

###
# An abbreviated sha is ambiguous, and a benchmark whose target is ambiguous cannot be compared with
# anything. The refusal names the length it got, which is what makes it actionable.
# @name plan_with_an_abbreviated_commit_is_refused_and_says_why
POST {{baseUrl}}/api/bench/plan
Content-Type: application/json

{
  "repo": "https://github.com/example/repo.git",
  "commit": "abc123",
  "suiteJson": "{}"
}

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal names the length seen and the reason abbreviations are refused', () => {
    assert.match(response.parsedBody.reason, /40 hexadecimal/);
    assert.match(response.parsedBody.reason, /got 6/);
  });
}}

###
# @name plan_with_a_suite_that_has_no_id_is_refused
POST {{baseUrl}}/api/bench/plan
Content-Type: application/json

{
  "repo": "https://github.com/example/repo.git",
  "commit": "{{wellFormedSha}}",
  "suiteJson": "{\"questions\":[]}"
}

?? status == 400

{{
  const assert = require('node:assert');
  test('an unidentifiable suite is named as such', () => {
    assert.match(response.parsedBody.reason, /no id/i);
  });
}}

