# @name runs_lists_what_this_database_holds
# @prod
GET {{baseUrl}}/api/bench/runs?limit=5
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('an empty database answers with [], never null — a caller iterates it either way', () => {
    assert.ok(Array.isArray(response.parsedBody));
  });
}}

###
# @name runs_accepts_a_zero_limit_without_inventing_a_default
# @prod
GET {{baseUrl}}/api/bench/runs?limit=0

?? status == 200

###
# A scoreboard for a run that does not exist is an EMPTY scoreboard, not a 404: nothing was scored,
# which is a true answer about a run nobody has recorded.
# @name a_scoreboard_for_an_unknown_run_is_empty_rather_than_missing
GET {{baseUrl}}/api/bench/runs/{{unknownRunId}}/scoreboard
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('zero scored and zero passed — and both numbers are present', () => {
    assert.strictEqual(response.parsedBody.scored, 0);
    assert.strictEqual(response.parsedBody.passed, 0);
  });
}}

###
# @name metrics_for_an_unknown_run_answer_without_failing
GET {{baseUrl}}/api/bench/runs/{{unknownRunId}}/metrics

?? status == 200

###
# The report DOES refuse for an unknown run, and the difference from the scoreboard above is
# deliberate: a scoreboard summarises what exists, a report is about a specific run — and naming a
# run that is not there is a mistake worth telling the caller about.
# @name a_report_for_an_unknown_run_is_404_and_names_the_id
GET {{baseUrl}}/api/bench/runs/{{unknownRunId}}/report?metric=recall_at_10

?? status == 404

{{
  const assert = require('node:assert');
  test('the refusal quotes the id it could not find', () => {
    assert.match(response.parsedBody.reason, /00000000-0000-0000-0000-000000000000/);
  });
}}

###
# @name a_report_without_a_metric_is_refused
GET {{baseUrl}}/api/bench/runs/{{unknownRunId}}/report

?? status == 400

###
# There is no default metric, and the refusal explains why rather than picking one — the metric that
# answers a retrieval question is not the one that answers a generation question.
# @name arms_without_a_metric_is_refused_with_the_reason_there_is_no_default
GET {{baseUrl}}/api/bench/arms

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal argues for itself instead of naming a missing parameter', () => {
    assert.match(response.parsedBody.reason, /name the metric/i);
  });
}}

###
# A named metric with nothing to compare is a 200 carrying a REFUSAL FIELD, not an error: the request
# was answerable, and the answer is "no arm qualifies, and here is what would have to be true".
# @name arms_with_a_metric_and_no_qualifying_run_explains_itself_in_a_200
GET {{baseUrl}}/api/bench/arms?metric=recall_at_10
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  const body = response.parsedBody;
  test('the metric asked for is echoed back', () => {
    assert.strictEqual(body.metricName, 'recall_at_10');
  });
  test('scopes and exclusions are arrays even when empty', () => {
    assert.ok(Array.isArray(body.scopes));
    assert.ok(Array.isArray(body.excluded));
  });
  test('when there is nothing to compare, the reason says what is missing', () => {
    if (body.scopes.length === 0) {
      assert.ok(body.refusal.length > 0,
        'an empty comparison with no refusal is a blank page the caller cannot act on');
    }
  });
}}

###
# @name arms_metrics_lists_what_can_be_asked_for
# @prod
GET {{baseUrl}}/api/bench/arms/metrics
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('the answer is a list, so a client can populate a chooser from it', () => {
    assert.ok(Array.isArray(response.parsedBody));
  });
}}

###
# @uncovered every 200 that needs REAL DATA — a scoreboard with scores, a report with a comparison, a
#            populated arms table. Producing them means running a campaign (a GPU, an engine, hours),
#            which is the benchmark's own subject rather than something a contract smoke can stage.
#            What is asserted here is the shape those routes answer in, including when empty.
