<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for coai-mcp: a console that speaks newline JSON-RPC over stdio the way the product does, so the
       driver's every protocol test runs through the REAL McpStdioClient and a real child process. Scripted by the
       file FAKE_COAI_SCRIPT names; it logs what it received and when into FAKE_COAI_EVENTS, which is how the
       concurrency test reads the number of sessions open and reviews in flight per endpoint.

       Not under tests/Bench.Tests/Fixtures/: the test project compiles every .cs file below it. Framework-dependent
       on purpose — an apphost beside its dll is the product's own checkout-build shape, which the pin must hash. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fake-coai-mcp</AssemblyName>
    <RootNamespace>FakeCoai</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
