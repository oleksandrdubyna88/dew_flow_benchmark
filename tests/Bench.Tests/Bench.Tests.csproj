<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Produced by dew_flow_mcp's own emitter tests and copied verbatim: the cross-repository
         contract is only proven by the other side's real output. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bench.Domain\Bench.Domain.csproj" />
    <ProjectReference Include="..\..\src\Bench.Delivered\Bench.Delivered.csproj" />
    <ProjectReference Include="..\..\src\Bench.Application\Bench.Application.csproj" />
    <ProjectReference Include="..\..\src\Bench.Infrastructure\Bench.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Bench.Api\Bench.Api.csproj" />
    <ProjectReference Include="../../src/Bench.Ui/Bench.Ui.csproj" />
    <ProjectReference Include="..\..\src\Bench.ServiceDefaults\Bench.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\hosts\Cli\Cli.csproj" />
    <!-- The model-arms module (tools/model-arms): ordinary references, so its assemblies are in this output folder for
         ModelArmsArchitectureTests to read — a guard that inspects what happens to be present is only as strong as
         what arrives, and here the arrival is on purpose. -->
    <ProjectReference Include="..\..\tools\model-arms\ModelArms.Core\ModelArms.Core.csproj" />
    <ProjectReference Include="..\..\tools\model-arms\ModelArms\ModelArms.csproj" />
    <!-- The fake coai-mcp: built first, NOT referenced as an assembly — the tests launch it from its own output
         folder, so its deployment set is its own and the product pin hashes a folder of the product's shape. -->
    <ProjectReference Include="..\FakeCoai\FakeCoai.csproj" ReferenceOutputAssembly="false" />
    <!-- The fake CLI the probe runner and campaign tests launch (S2): the same arrangement — built first, launched from its
         own output folder, pinned by the real ProductPinReader. -->
    <ProjectReference Include="..\FakeCli\FakeCli.csproj" ReferenceOutputAssembly="false" />
    <!-- The test-only holder of the gate lock (model arms E2.S6): launched from its own output folder, never referenced as an assembly. -->
    <ProjectReference Include="..\GateHolder\GateHolder.csproj" ReferenceOutputAssembly="false" />
    <!-- The test-only killed lock (model arms E5.S1): a lock that SIGKILLs itself half-way, launched from its own output folder. -->
    <ProjectReference Include="..\LockCrasher\LockCrasher.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 8 test threads (common.local-cpu-budget). The file must reach the output folder:
         measured 2026-10-11 on xunit.v3 4.0.1, an uncopied xunit.runner.json is never read and the
         runner takes one thread per CPU (24). A command-line max-threads switch still overrides it.
         Not on CI: maxParallelThreads is an exact number, so a 4-vCPU runner would be RAISED to 8. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(CI)' != 'true'" />
  </ItemGroup>

</Project>
