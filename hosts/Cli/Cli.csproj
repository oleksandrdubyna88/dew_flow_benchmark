<Project Sdk="Microsoft.NET.Sdk">

  <!-- The first surface, and the one an agent drives. Thin: parse, call a use case, render, exit. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bench</AssemblyName>
    <RootNamespace>Bench.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The run verb builds a small container: a DbContext, the two stores, a model runtime and an http
         factory. Hand-wiring four scoped services would be the same code with a worse failure mode. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Verbosity is a config edit and a restart, never an edited call site — so the CLI reads an
         optional appsettings.json beside itself and the environment, exactly as every other host does. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bench.Application\Bench.Application.csproj" />
    <ProjectReference Include="..\..\src\Bench.Infrastructure\Bench.Infrastructure.csproj" />
    <!-- A CLI verb that builds a container is a host, and a host logs where every other host does:
         coloured to the console, one file per run on disk. -->
    <ProjectReference Include="..\..\src\Bench.ServiceDefaults\Bench.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
