<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The WRITE surface for agent-session traces, and the only one. It is a separate host from bench-api
       rather than two routes on it, for three reasons that all point the same way: bench-api is read-only by
       an explicit decision its own Program.cs argues at length; this process must be up whenever the
       OPERATOR is working, which is a different lifecycle from "whenever somebody reads a report"; and a
       hook fires before every tool call, so the thing it reaches should be as small as a process can be.

       It applies NO migrations, like every host here except the CLI — but unlike bench-api it REFUSES to
       start against a schema that is not current, because a write surface that silently cannot write loses
       data that, unlike a report, can never be re-read. -->

  <PropertyGroup>
    <AssemblyName>bench-collector</AssemblyName>
    <RootNamespace>Bench.CollectorHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bench.Api\Bench.Api.csproj" />
    <ProjectReference Include="..\..\src\Bench.Infrastructure\Bench.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Bench.ServiceDefaults\Bench.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
