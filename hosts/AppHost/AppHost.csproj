<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <!-- DEV orchestration only: `dotnet run` here brings up this benchmark's OWN database, isolated from
       every product store on the machine. It never ships. Keep the SDK and every Aspire.Hosting.*
       package on the SAME version — a straddled pair spawns a second stray dashboard. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dew-flow-bench-apphost-2f5c8a10</UserSecretsId>
    <!-- This DEV-only AppHost runs without the Aspire CLI bundle: AspireUseCliBundle is the SDK's default (false)
         and is left alone. The SDK warns ASPIRE010 about that, and the warning's own text names suppressing it as
         the way to continue without the bundle, so it is suppressed here and nowhere else. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- IsAspireProjectResource=false is required, not tidiness: the AppHost SDK treats every
         ProjectReference as an app RESOURCE to orchestrate and stops referencing its assembly, so without
         this the shared logging type is simply not found at compile time. -->
    <ProjectReference Include="..\..\src\Bench.ServiceDefaults\Bench.ServiceDefaults.csproj" IsAspireProjectResource="false" />
    <!-- App RESOURCES, so no IsAspireProjectResource here: these are meant to be orchestrated. -->
    <ProjectReference Include="..\Api\Api.csproj" />
    <ProjectReference Include="..\Collector\Collector.csproj" />
  </ItemGroup>

</Project>
