new file mode 100644
index 00000000..0bcb1f1a
--- /dev/null
+++ b/src_mcp/tests/KimiDeleterHookCollection.cs
@@ -0,0 +1,11 @@
+using Xunit;
+
+namespace CoaiMcp.Tests;
+
+/// <summary>
+/// The classes that set <c>GitScratch.AfterUnlink</c> or <c>KimiHome.AfterUnlink</c>. Both hooks are process-wide statics, and xUnit runs
+/// classes in parallel, so a recorder set by one class fires inside another class's deleter. Every class that sets one joins this collection,
+/// which runs them one at a time (DR1 H4).
+/// </summary>
+[CollectionDefinition("kimi-deleter-hook", DisableParallelization = true)]
+public sealed class KimiDeleterHookCollection;
