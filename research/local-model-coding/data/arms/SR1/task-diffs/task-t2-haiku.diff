+    /// <summary>
+    /// Kimi (S5.6.3 of todo/PLAN_vibe_and_kimi_runtimes.md): NO flag, ever — its confinement is the shim's, not its argv (D15). A none row
+    /// stands in an EMPTY scratch folder; a disk row stands in the COPY of its roots (D6), because its AGENTS.md, skills and .mcp.json load from disk (M-K9).
+    /// </summary>
+    [Fact]
+    public void Kimi_None_StandsInAnEmptyFolder_Disk_InTheCopyOfItsRoots_NoFlagEver_AndWebIsRefused()
+    {
+        var none = Plan("kimi", CapabilityGrant.None);
+        none.Flags.Should().BeEmpty();
+        none.Leading.Should().BeEmpty();
+        none.Cwd.Should().Be(CwdKind.Scratch);
+        none.AddDirs.Should().BeEmpty();
+        none.SnapshotSources.Should().BeEmpty();
+        none.Flag.Should().Be(AdmissionFlag.Unconfined);
+
+        var disk = Plan("kimi", CapabilityGrant.Disk(RootA, RootB));
+        disk.Flags.Should().BeEmpty("Kimi's confinement is the shim's (D15), so the plan carries no flag");
+        disk.Leading.Should().BeEmpty();
+        disk.Cwd.Should().Be(CwdKind.Snapshot, "D6: Kimi's AGENTS.md, skills and .mcp.json load from disk, so it stands in the copy of its roots (M-K9)");
+        disk.AddDirs.Should().BeEmpty("AddDirs are launch flags, and Kimi is never given one");
+        disk.SnapshotSources.Should().Equal([RootA, RootB], "the roots it reads through their copies");
+        disk.Flag.Should().Be(AdmissionFlag.Unconfined);
+
+        ConfinementPlanner.Plan("kimi", CapabilityGrant.Web).Should().BeOfType<Confinement.Refused>()
+            .Which.Reason.Should().Contain("not been measured").And.Contain("RESULTS_kimi_confinement.md");
+    }
