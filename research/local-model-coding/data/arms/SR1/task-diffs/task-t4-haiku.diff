+using System.Text.Json;
+using CoaiMcp.Runners.Acp;
+using CoaiMcp.Runners.Consultation;
+using CoaiMcp.Runners.Files;
+using CoaiMcp.Runners.Kimi;
+using CoaiMcp.Runners.Platform;
+using CoaiMcp.Runners.Processes;
+using CoaiMcp.Runners.Vibe;
+using CoaiMcp.Server;
+using FluentAssertions;
+using Xunit;
+
+namespace CoaiMcp.Tests;
+
+/// <summary>
+/// <c>--check-consultant</c> with a Kimi consultant (E5.5 of <c>todo/PLAN_vibe_and_kimi_runtimes_E5.md</c>, S5.5.1–S5.5.4): the check runs one
+/// Kimi turn as a consultation does — in a COPY of the check's scratch repository, on a ONE-SHOT owned home under the homes root
+/// (<c>coai-vh\&lt;8&gt;\kh-&lt;10 hex&gt;</c>), and disposes that home junction-first on every ending: answered, failed, cancelled — and in the
+/// root-less shape, where the home is kept in the scratch and goes with it.
+/// </summary>
+/// <remarks>
+/// The real check, the real git and the real launch control over a fake person's sign-in (<see cref="KimiFixture"/>); only the Kimi shim is
+/// played (<see cref="PlayedKimi"/>), so no turn is paid for and the real <c>kimi</c> is never started. Everything made lives under this test's
+/// own <c>testsToDelete-kimi-check-</c> folder; the person's folder lives outside the homes root that is deleted.
+/// </remarks>
+[Collection("fakecli-env")]
+public sealed class AKimiConsultantCheckTests : IDisposable
+{
+    private readonly KimiFixture _person = new();
+    private readonly TempDir _root = TempDir.For("testsToDelete-kimi-check-");
+    private readonly List<string> _warned = [];
+    private readonly List<string> _unlinkedByTheDeleter = [];
+
+    public void Dispose()
+    {
+        GitScratch.AfterUnlink = null;
+        KimiHome.AfterUnlink = null;
+        _root.Dispose();
+        _person.Dispose();
+    }
+
+    private string Homes => Directory.CreateDirectory(_root.At("homes")).FullName;
+
+    private string Data => Directory.CreateDirectory(_root.At("data")).FullName;
+
+    /// <summary>The check's scratch repository is made here.</summary>
+    private string Temp => Directory.CreateDirectory(_root.At("temp")).FullName;
+
+    private PanelSettings Settings(string homesRoot) => new()
+    {
+        Providers = [],
+        DataDir = Data,
+        ReviewerTimeout = TimeSpan.FromSeconds(60),
+        ConsultEnabled = true,
+        ConsultantHomesRoot = homesRoot,
+        Consultants = new Dictionary<string, ConsultantChoice> { [CallerIdentity.Claude] = new("my-kimi", Runtime: "kimi") },
+    };
+
+    /// <summary>Several scopes, given back in reverse.</summary>
+    private sealed class Scopes(params IDisposable[] scopes) : IDisposable
+    {
+        public void Dispose()
+        {
+            foreach (var scope in scopes.Reverse())
+            {
+                scope.Dispose();
+            }
+        }
+    }
+
+    /// <summary>The person, the host and the lock root this check's Kimi adapter sees — set by a SYNCHRONOUS call, so it reaches every call the check awaits.</summary>
+    private IDisposable StandIn() => new Scopes(
+        WindowsStandIn.Begin(),
+        KimiCredentialsLock.RootFor(Path.Combine(_person.Folder, "locks")),
+        KimiSeams.Using(HostKind.Windows, new KimiSeams(_person.PlacesAt, () => (PlayedKimi.Shim, []))));
+
+    private async Task<(int Code, JsonElement Said)> CheckAsync(PanelSettings settings, PlayedKimi played, CancellationToken ct)
+    {
+        var (code, stdout, _) = await ConsultantCheckMode.AnswerAsync(settings, ["--check-consultant", "--caller", "claude"], played, Temp, _warned.Add, Noticing.None, ct);
+
+        return (code, stdout.Length > 0 ? JsonDocument.Parse(stdout).RootElement.Clone() : default);
+    }
+
+    /// <summary>The played shim answers the check's question by reading CHECK.md in the copy the shim was started in.</summary>
+    private static PlayedKimi Answering(IProcessLauncher inner) => new(inner)
+    {
+        Turn = (_, request) => PlayedKimi.Answered(
+            PlayedKimi.SessionOf(request),
+            1000,
+            10,
+            answer: $"marker: {File.ReadAllText(Path.Combine(After(request.Arguments, "--cwd"), "CHECK.md")).Trim().Split(' ')[^1].TrimEnd('.')}\ncanary: CANNOT"),
+    };
+
+    private static string After(IReadOnlyList<string> args, string flag) => args[args.ToList().IndexOf(flag) + 1];
+
+    private void ThePersonsFolderIsWhole(IReadOnlyList<string> before) =>
+        _person.Hash().Should().Equal(before, "the person's folder: the same names, bytes and read-only bits as before");
+
+    private void TheDeleterNeverMetTheJunction() =>
+        _unlinkedByTheDeleter.Should().BeEmpty("the deleter's unlink recorder must not be invoked, because KimiHome unlinks the junction first");
+
+    // ---------- S5.5.1 ----------
+
+    [Fact]
+    public async Task AKimiCheck_RunsInACopy_OnAOneShotHome()
+    {
+        using var stood = StandIn();
+        var played = Answering(new ProcessLauncher());
+
+        var (code, said) = await CheckAsync(Settings(Homes), played, TestContext.Current.CancellationToken);
+
+        code.Should().Be(0);
+        said.GetProperty("state").GetString().Should().Be("answered", said.ToString());
+        said.GetProperty("markerRead").GetBoolean().Should().BeTrue();
+        said.GetProperty("canary").GetString().Should().Be("not-attempted");
+
+        var shim = played.Shims.Should().ContainSingle().Subject.Request;
+        After(shim.Arguments, "--cwd").Should().Contain(Path.Combine("own", "tree"), "a copy in the check's own scratch, never the repository");
+
+        var home = After(shim.Arguments, AcpWords.HomeFlag);
+        Path.GetFileName(home).Should().MatchRegex("^kh-[0-9a-f]{10}$");
+        Path.GetFileName(Path.GetDirectoryName(Path.GetDirectoryName(home)!)!).Should().Be(VibeHomes.OneShotFolder);
+        Path.GetDirectoryName(Path.GetDirectoryName(Path.GetDirectoryName(home)!)!).Should().Be(Homes);
+
+        Directory.EnumerateDirectories(Temp, "coai-check-*").Should().BeEmpty("the copy goes with the check's scratch");
+    }
+
+    // ---------- S5.5.2 ----------
+
+    [Theory]
+    [InlineData("answered")]
+    [InlineData("the turn fails exit 70")]
+    public async Task AfterTheCheck_TheHomeIsGone_JunctionFirst(string ending)
+    {
+        using var stood = StandIn();
+        GitScratch.AfterUnlink = _unlinkedByTheDeleter.Add;
+        var before = _person.Hash();
+        var played = ending == "answered"
+            ? Answering(new ProcessLauncher())
+            : new PlayedKimi(new ProcessLauncher()) { Turn = (_, request) => PlayedKimi.Lost(PlayedKimi.SessionOf(request)) };
+
+        var (_, said) = await CheckAsync(Settings(Homes), played, TestContext.Current.CancellationToken);
+
+        played.Shims.Should().ContainSingle();
+        Directory.EnumerateFileSystemEntries(Path.Combine(Homes, VibeHomes.OneShotFolder)).Should().BeEmpty("the one-shot folder `coai-vh\\<8>` is gone");
+        TheDeleterNeverMetTheJunction();
+        ThePersonsFolderIsWhole(before);
+        if (ending != "answered")
+        {
+            said.GetProperty("state").GetString().Should().NotBe("answered", said.ToString());
+        }
+    }
+
+    // ---------- S5.5.3 ----------
+
+    [Fact]
+    public async Task ACheckCancelledMidTurn_StillDisposesItsHome()
+    {
+        using var stood = StandIn();
+        GitScratch.AfterUnlink = _unlinkedByTheDeleter.Add;
+        var before = _person.Hash();
+        var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var played = new PlayedKimi(new ProcessLauncher())
+        {
+            During = async (_, ct) =>
+            {
+                started.TrySetResult();
+                await Task.Delay(Timeout.Infinite, ct);
+            },
+        };
+        using var stop = new CancellationTokenSource();
+
+        var run = CheckAsync(Settings(Homes), played, stop.Token);
+        await started.Task.WaitAsync(TimeSpan.FromSeconds(30), TestContext.Current.CancellationToken);
+        await stop.CancelAsync();
+        var (_, said) = await run;
+
+        said.GetProperty("failureKind").GetString().Should().Be(ConsultFailureKinds.Cancelled, said.ToString());
+        Directory.EnumerateFileSystemEntries(Path.Combine(Homes, VibeHomes.OneShotFolder)).Should().BeEmpty("the home's folder goes when the check ends, whatever ended it");
+        TheDeleterNeverMetTheJunction();
+        ThePersonsFolderIsWhole(before);
+    }
+
+    // ---------- S5.5.4 ----------
+
+    [Fact]
+    public async Task ARootlessCheck_KeepsTheHomeInItsScratch_AndDisposesItJunctionFirst()
+    {
+        using var stood = StandIn();
+        GitScratch.AfterUnlink = _unlinkedByTheDeleter.Add;
+        var before = _person.Hash();
+        var played = Answering(new ProcessLauncher());
+
+        var (code, said) = await CheckAsync(Settings(string.Empty), played, TestContext.Current.CancellationToken);
+
+        code.Should().Be(0);
+        said.GetProperty("state").GetString().Should().Be("answered", said.ToString());
+
+        // With no homes root the home is kept one level down in the check's own scratch, <scratch>\own\kh-*, and the scratch goes with it.
+        var home = After(played.Shims.Should().ContainSingle().Subject.Request.Arguments, AcpWords.HomeFlag);
+        Path.GetFileName(home).Should().MatchRegex("^kh-[0-9a-f]{10}$");
+        Path.GetFileName(Path.GetDirectoryName(home)!).Should().Be(ConsultantCheck.OwnName);
+        Path.GetDirectoryName(Path.GetDirectoryName(home)!)!.Should().StartWith(Path.Combine(Temp, ConsultCheckScratch.Prefix));
+        Directory.EnumerateDirectories(Temp, "coai-check-*").Should().BeEmpty("the scratch, and the home in it, are removed when the check ends");
+        TheDeleterNeverMetTheJunction();
+        ThePersonsFolderIsWhole(before);
+    }
+}
