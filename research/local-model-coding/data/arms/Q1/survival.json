        "var parent = Directory.GetParent(cwd);",
        "if (parent != null)",
        "Directory.Exists(parent.FullName).Should().BeFalse();",
        "var tempDirs = Directory.GetDirectories(Path.GetTempPath(), \"coai-question-*\");",
        "foreach (var dir in tempDirs)",
