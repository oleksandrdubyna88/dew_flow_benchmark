+    [Fact]
+    public async Task AKimiDiskRow_RefusedBeforeTheLaunch_LeavesNothingBehind()
+    {
+        var before = _person.Hash();
+        var notGit = Directory.CreateDirectory(_dir.At("not-git")).FullName;
