+using System.Text.Json;
+using CoaiMcp.Core.QuestionConsult;
+using CoaiMcp.Core.Rounds;
+using CoaiMcp.Runners.Acp;
+using CoaiMcp.Runners.Files;
+using CoaiMcp.Runners.Kimi;
+using CoaiMcp.Runners.Platform;
+using CoaiMcp.Runners.Processes;
+using CoaiMcp.Runners.Vibe;
+using CoaiMcp.Server;
+using FluentAssertions;
+using Serilog.Core;
+using Xunit;
+
+namespace CoaiMcp.Tests;
+
+/// <summary>
+/// A Kimi question-consultant row (S5.6.7 of <c>todo/PLAN_vibe_and_kimi_runtimes_E5.md</c>): a <c>disk</c> row on Kimi reads its operator's
+/// GRANTED ROOTS — each copied into a sub-folder of the row's own snapshot — and is told the COPIES' paths, never the originals; its home
+/// is kept in a one-shot folder under the homes root; and once the row ends — answered, refused before the launch, or cancelled mid-turn — no
+/// scratch and no one-shot folder remain, the junction was unlinked first, and the person's sign-in folder is intact.
+/// </summary>
+/// <remarks>
+/// The whole <c>ask_consultants</c> flow through the service, git for real, the Kimi shim played in process (<see cref="PlayedKimi"/>) over a
+/// fake person (<see cref="KimiFixture"/>). Nothing here skips: Kimi's service arms run on every OS through <see cref="WindowsStandIn"/>.
+/// </remarks>
+public sealed class AKimiQuestionRowTests : IAsyncLifetime
+{
+    private readonly ProcessLauncher _launcher = new();
+    private readonly TempDir _dir = TempDir.For("testsToDelete-qkimi-");
+
+    private string Repo => _dir.At("repo");
+
+    private string Other => _dir.At("other");
+
+    public async ValueTask InitializeAsync()
+    {
+        await RepositoryAsync(Repo, ("src/Mailer.cs", "void Send() { }\n"), ("docs/notes.md", "not granted\n"));
+        await RepositoryAsync(Other, ("Retry.cs", "int Attempts = 3;\n"));
+    }
+
+    public ValueTask DisposeAsync()
+    {
+        _dir.Dispose();
+
+        return ValueTask.CompletedTask;
+    }
+
+    /// <summary>Several scopes, given back in reverse.</summary>
+    private sealed class Scopes(params IDisposable[] scopes) : IDisposable
+    {
+        public void Dispose()
+        {
+            foreach (var scope in scopes.Reverse())
+            {
+                scope.Dispose();
+            }
+        }
+    }
+
+    /// <summary>
+    /// The person, the host and the lock root this flow's Kimi adapters see — set by a SYNCHRONOUS call, so the values reach the test's own flow
+    /// and every service call it awaits.
+    /// </summary>
+    private static IDisposable StandIn(KimiFixture person) => new Scopes(
+        WindowsStandIn.Begin(),
+        KimiCredentialsLock.RootFor(Path.Combine(person.Folder, "locks")),
+        KimiSeams.Using(HostKind.Windows, new KimiSeams(person.PlacesAt, () => (PlayedKimi.Shim, []))));
+
+    private async Task RepositoryAsync(string at, params (string Path, string Text)[] files)
+    {
+        Directory.CreateDirectory(at);
+        foreach (var (path, text) in files)
+        {
+            var full = Path.Combine([at, .. path.Split('/')]);
+            Directory.CreateDirectory(Path.GetDirectoryName(full)!);
+            await File.WriteAllTextAsync(full, text, TestContext.Current.CancellationToken);
+        }
+
+        foreach (var args in (string[][])[["init", "-b", "main"], ["config", "user.email", "t@example.com"], ["config", "user.name", "t"], ["add", "."], ["commit", "-m", "base"]])
+        {
+            var result = await _launcher.RunAsync(new ProcessRequest("git", args, at), TestContext.Current.CancellationToken);
+            result.ExitCode.Should().Be(0, string.Join(' ', args) + ": " + result.StdErr);
+        }
+    }
+
+    /// <summary>The service with a homes root — a home-keeping row reserves its one-shot folder there (D1) — and one Kimi <c>disk</c> question row.</summary>
+    private PanelService Service(PlayedKimi played, string homesRoot, params string[] roots) => new(
+        new PanelSettings
+        {
+            ConsultantHomesRoot = homesRoot,
+            Providers = [],
+            Rounds = PanelConfig.Uniform(3, 2, StagePolicy.Human),
+            DataDir = _dir.At("data"),
+            ReviewerTimeout = TimeSpan.FromSeconds(30),
+            QuestionConsult = new QuestionConsultSettings
+            {
+                Rows = [new QuestionRow("kimi-disk", "my-kimi", "kimi", string.Empty, string.Empty, string.Empty, string.Empty, "question-disk", Enabled: true)],
+                Roots = roots,
+                RowBudget = TimeSpan.FromSeconds(30),
+            },
+        },
+        VaultKeys.None("no vault in tests"),
+        default,
+        played,
+        Logger.None,
+        Noticing.None);
+
+    private async Task<JsonElement> AskAsync(PanelService service, CancellationToken? ct = null) =>
+        JsonDocument.Parse(await service.AskConsultantsAsync(
+            Repo, "Which helper retries an outbound send?", "I tried a fixed wait.", ct: ct ?? TestContext.Current.CancellationToken)).RootElement;
+
+    private static JsonElement TheRow(JsonElement reply)
+    {
+        reply.TryGetProperty("answers", out var answers).Should().BeTrue(reply.ToString());
+
+        return answers.EnumerateArray().Should().ContainSingle().Subject;
+    }
+
+    private static string After(IReadOnlyList<string> args, string flag) => args[args.ToList().IndexOf(flag) + 1];
+
+    /// <summary>
+    /// S5.6.7: a <c>disk</c> Kimi row reads a copy of each granted root and names the copies, keeps its home in a one-shot folder, and after the
+    /// ending leaves no scratch, no one-shot folder, no junction unlinked by the deleter, and the person's sign-in folder intact.
+    /// </summary>
+    [Theory]
+    [InlineData("answered")]
+    [InlineData("refused-before-the-launch")]
+    [InlineData("cancelled-mid-turn")]
+    public async Task AKimiDiskRow_ReadsItsCopies_AndLeavesNothingBehind(string ending)
+    {
+        using var person = new KimiFixture();
+        using var stood = StandIn(person);
+        var homes = Directory.CreateDirectory(_dir.At("homes")).FullName;
+        var recorded = new List<string>();
+        var before = person.Hash();
+        var copies = new List<string>();
+        using var caller = CancellationTokenSource.CreateLinkedTokenSource(TestContext.Current.CancellationToken);
+        var granted = Path.Combine(Repo, "src");
+        var roots = new[] { granted, Other };
+        if (ending == "refused-before-the-launch")
+        {
+            var plain = Directory.CreateDirectory(_dir.At("plain")).FullName;
+            await File.WriteAllTextAsync(Path.Combine(plain, "notes.txt"), "not a repository", TestContext.Current.CancellationToken);
+            roots = [granted, plain];
+        }
+
+        var played = new PlayedKimi(_launcher)
+        {
+            During = ending == "cancelled-mid-turn"
+                ? async (_, ct) =>
+                {
+                    await caller.CancelAsync();
+                    ct.ThrowIfCancellationRequested();
+                }
+                : (request, _) =>
+                {
+                    copies.AddRange(Directory.EnumerateDirectories(request.WorkingDirectory));
+
+                    return Task.CompletedTask;
+                },
+        };
+        var service = Service(played, homes, roots);
+
+        GitScratch.AfterUnlink = recorded.Add;
+        try
+        {
+            JsonElement reply = default;
+            if (ending == "cancelled-mid-turn")
+            {
+                var asking = async () => await AskAsync(service, caller.Token);
+
+                await asking.Should().ThrowAsync<OperationCanceledException>();
+            }
+            else
+            {
+                reply = await AskAsync(service);
+            }
+
+            if (ending == "answered")
+            {
+                TheRow(reply).GetProperty("status").GetString().Should().Be(RowOutcomes.Answered, reply.ToString());
+                var shim = played.Shims.Should().ContainSingle().Subject.Request;
+                copies.Should().HaveCount(2, "one copy per granted root, in the row's snapshot");
+                foreach (var copy in copies)
+                {
+                    shim.StdIn.Should().Contain(copy, "the prompt names the copies Kimi can read");
+                }
+
+                shim.StdIn.Should().NotContain(granted, "never the original of a granted root");
+                shim.StdIn.Should().NotContain(Other, "never the original of a granted root");
+                shim.Arguments.Should().NotContain(AcpWords.SessionFlag, "a row's copy is one-shot: a first turn, never a continuation");
+                var home = After(shim.Arguments, AcpWords.HomeFlag);
+                home.Should().StartWith(Path.Combine(homes, VibeHomes.OneShotFolder) + Path.DirectorySeparatorChar, "the home is kept in a one-shot folder under the homes root");
+                Directory.Exists(Path.GetDirectoryName(home)).Should().BeFalse("the row's one-shot folder is gone once it answered");
+                Directory.Exists(shim.WorkingDirectory).Should().BeFalse("the row's scratch and its copies are gone once it answered");
+            }
+            else if (ending == "refused-before-the-launch")
+            {
+                TheRow(reply).GetProperty("status").GetString().Should().Be(RowOutcomes.Refused, reply.ToString());
+                played.Shims.Should().BeEmpty("nothing of Kimi's starts for a row whose copy was refused");
+            }
+            else
+            {
+                var shim = played.Shims.Should().ContainSingle().Subject.Request;
+                Directory.Exists(Path.GetDirectoryName(After(shim.Arguments, AcpWords.HomeFlag))).Should().BeFalse("the row's one-shot folder is gone once it was cancelled");
+                Directory.Exists(shim.WorkingDirectory).Should().BeFalse("the row's scratch and its copies are gone once it was cancelled");
+            }
+        }
+        finally
+        {
+            GitScratch.AfterUnlink = null;
+        }
+
+        var coaiVh = Path.Combine(homes, VibeHomes.OneShotFolder);
+        if (Directory.Exists(coaiVh))
+        {
+            Directory.EnumerateFileSystemEntries(coaiVh).Should().BeEmpty("the row's one-shot folder is gone");
+        }
+
+        recorded.Should().BeEmpty("the home's junction was unlinked first, so the deleter never met it");
+        person.Hash().Should().Equal(before, "the person's sign-in folder is intact");
+    }
+}
