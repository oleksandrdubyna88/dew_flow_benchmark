+    private static void AssertKimiRowRequest(Runners.Processes.ProcessRequest request)
+    {
+        var home = request.Arguments.SkipWhile(argument => argument != Runners.Acp.AcpWords.HomeFlag).Skip(1).First();
+        Path.GetDirectoryName(home).Should().Be(RowFolder, "the home is a child of the row's own folder");
+        Path.GetFileName(home).Should().StartWith("kh-");
+        request.Arguments.Should().NotContain(Runners.Acp.AcpWords.SessionFlag, "a one-shot row resumes nothing");
+        request.Arguments.Should().NotContain(argument => argument.Contains(RootA) || argument.Contains(RootB), "a root is never a launch argument");
+        request.InheritsEnvironment.Should().BeFalse();
+        request.Passthrough.Should().BeEquivalentTo(Runners.Processes.ProcessEnvironment.Minimal);
+        Runners.Kimi.KimiEnvironment.Refusal(request, Runners.Kimi.KimiPlaces.ForShim(home, Path.Combine(RowFolder, "persons-bin")))
+            .Should().BeEmpty("the one launch control admits exactly what the adapter builds");
+    }
