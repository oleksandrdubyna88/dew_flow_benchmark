+    /// <remarks>
+    /// No flags, ever: Kimi's confinement is the shim's (D15 of todo/PLAN_vibe_and_kimi_runtimes.md), never its argv, so the plan
+    /// carries none and <see cref="SandboxVocabulary"/> gains nothing. <c>Read</c> is bounded to the working folder (M-K6), so a disk
+    /// row's roots are COPIED into the snapshot it stands in (D6; M-K9: a branch's own configuration loads from disk) and a none row
+    /// stands in an empty folder. <c>Grep</c> and <c>Glob</c> read the disk either way (M-K6) — the matrix's flag, not the plan's.
+    /// </remarks>
+    private static Confinement.Planned Kimi(CapabilityGrant grant, AdmissionFlag flag) => grant.Capability switch
+    {
+        Capability.Disk => new("kimi", grant, [], [], CwdKind.Snapshot, [], flag) { SnapshotSources = grant.Roots },
+        // `web` never reaches here: the matrix refuses it (no Kimi cell exercises the web).
+        _ => new("kimi", grant, [], [], CwdKind.Scratch, [], flag),
+    };
+
     private static IEnumerable<string> AddDirs(string flag, IReadOnlyList<string> roots) =>
         roots.SelectMany(root => (string[])[flag, root]);
 }
